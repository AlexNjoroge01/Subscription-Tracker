// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "postgresql"
}

// User role enum
enum UserRole {
  USER
  SUPERUSER
}

// User model - Authentication and user preferences
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String
  image         String?
  currency      String         @default("KES")
  monthlyBudget Float?
  role          UserRole       @default(USER)
  
  // Plan tracking
  planId        String?        @default("starter-plan")
  trialEndsAt   DateTime?      // When the trial ends
  planEndsAt    DateTime?      // When the paid plan ends (for subscriptions)
  
  // Notification preferences
  emailNotificationsEnabled Boolean @default(true)
  notifySevenDays          Boolean @default(true)
  notifyThreeDays          Boolean @default(true)
  notifyOneDay             Boolean @default(true)
  notifyOverdue            Boolean @default(true)
  notifyBudgetWarning      Boolean @default(true)
  dailyDigestEnabled       Boolean @default(false)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  subscriptions Subscription[]
  categories    Category[]
  notifications Notification[]
  payments      Payment[]
  plan          PaymentPlan?       @relation(fields: [planId], references: [id])
  passwordResetTokens PasswordResetToken[]
}

// Category model - Subscription categorization with budgets
model Category {
  id          String         @id @default(cuid())
  userId      String
  name        String
  color       String         @default("#3b82f6")
  icon        String?
  budgetLimit Float?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  
  @@unique([userId, name])
}

// Subscription model - Core subscription tracking
model Subscription {
  id              String   @id @default(cuid())
  userId          String
  name            String
  amount          Float
  currency        String   @default("KES")
  billingCycle    String   // "monthly", "annual", "custom"
  customDays      Int?     // for custom billing cycles
  nextBillingDate DateTime
  status          String   @default("active") // "active", "cancelled", "overdue", "scheduled"
  categoryId      String?
  familyMember    String?
  logo            String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notifications Notification[]
}

// Notification model - In-app notifications and alerts
model Notification {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String?
  type           String       // "renewal_reminder", "overdue", "budget_warning", "digest"
  message        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// Payment Plan model - Subscription plans for the app
model PaymentPlan {
  id          String   @id @default(cuid())
  name        String   // "starter", "pro", "premium"
  price       Float    // Price in USD
  currency    String   @default("USD")
  interval    String   @default("monthly") // "monthly", "annual"
  features    String[] // Array of feature strings
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  payments Payment[]
  users    User[]
}

// Payment model - Track payments from users
model Payment {
  id              String      @id @default(cuid())
  userId          String
  planId          String
  amount          Float
  currency        String      @default("KES")
  status          String      @default("pending") // "pending", "completed", "failed", "refunded"
  provider        String      @default("paystack")
  providerRef     String?     @unique // Paystack reference
  providerId      String?     // Paystack transaction ID
  paidAt          DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  
  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan PaymentPlan @relation(fields: [planId], references: [id])
  
  @@index([userId])
  @@index([providerRef])
}

// Password Reset Token model - For password reset functionality
model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([userId])
}
