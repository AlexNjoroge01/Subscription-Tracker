// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// User model - Authentication and user preferences
model User {
  id            String         @id @default(cuid())
  name          String?
  email         String         @unique
  emailVerified DateTime?
  password      String
  image         String?
  currency      String         @default("KES")
  monthlyBudget Float?
  
  // Notification preferences
  emailNotificationsEnabled Boolean @default(true)
  notifySevenDays          Boolean @default(true)
  notifyThreeDays          Boolean @default(true)
  notifyOneDay             Boolean @default(true)
  notifyOverdue            Boolean @default(true)
  notifyBudgetWarning      Boolean @default(true)
  dailyDigestEnabled       Boolean @default(false)
  
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  
  subscriptions Subscription[]
  categories    Category[]
  notifications Notification[]
}

// Category model - Subscription categorization with budgets
model Category {
  id          String         @id @default(cuid())
  userId      String
  name        String
  color       String         @default("#3b82f6")
  icon        String?
  budgetLimit Float?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptions Subscription[]
  
  @@unique([userId, name])
}

// Subscription model - Core subscription tracking
model Subscription {
  id              String   @id @default(cuid())
  userId          String
  name            String
  amount          Float
  currency        String   @default("KES")
  billingCycle    String   // "monthly", "annual", "custom"
  customDays      Int?     // for custom billing cycles
  nextBillingDate DateTime
  status          String   @default("active") // "active", "cancelled", "overdue", "scheduled"
  categoryId      String?
  familyMember    String?
  logo            String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category      Category?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  notifications Notification[]
}

// Notification model - In-app notifications and alerts
model Notification {
  id             String       @id @default(cuid())
  userId         String
  subscriptionId String?
  type           String       // "renewal_reminder", "overdue", "budget_warning", "digest"
  message        String
  read           Boolean      @default(false)
  createdAt      DateTime     @default(now())
  
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}
